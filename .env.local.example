# Supabase
# Copy this file to .env.local and fill in your values.
# Get these from: https://supabase.com/dashboard -> your project -> Settings -> API

NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — required for email notifications on publish.
# Get from: Supabase Dashboard -> Settings -> API -> service_role key (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Manager invite code — anyone registering as manager must enter this exact code.
# Set to any secret value. Leave blank to disable the check.
NEXT_PUBLIC_MANAGER_INVITE_CODE=your-secret-code

# Super manager — this account cannot be demoted or deactivated via the UI.
NEXT_PUBLIC_SUPER_MANAGER_EMAIL=your-email@example.com

# Resend email integration (optional — schedule is published even without email)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=shifts@yourdomain.com
NEXT_PUBLIC_APP_URL=https://your-app-url.vercel.app
